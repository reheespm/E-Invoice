@page "/admin/customers"
@attribute [Authorize(Policy = Permissions.Customer.View)]
@using EInvoice.Application.Customers
@inject ICustomerManagementService CustomerService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<AuthorizeView Policy="@Permissions.Customer.Create" Context="createContext">
    <Authorized>
        <a class="btn btn-primary mb-3" href="/admin/customers/create">Add Customer</a>
    </Authorized>
</AuthorizeView>

@if (statusMessage is not null)
{
    <div class="alert @(statusIsError ? "alert-danger" : "alert-success")">@statusMessage</div>
}

@if (customers is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Address</th>
                <th>City</th>
                <th>Country</th>
                <th>TRN</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in customers)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.CompanyName</td>
                    <td>@customer.Address1</td>
                    <td>@customer.City</td>
                    <td>@customer.Country</td>
                    <td>@customer.Trn</td>
                    <td>@customer.Phone</td>
                    <td>@customer.Email</td>
                    <td>
                        @customer.CreatedAtUtc.ToString("g")
                        @if (!string.IsNullOrWhiteSpace(customer.CreatedBy))
                        {
                            <div class="text-muted small">by @customer.CreatedBy</div>
                        }
                    </td>
                    <td class="text-nowrap">
                        <AuthorizeView Policy="@Permissions.Customer.Edit" Context="editContext">
                            <Authorized>
                                <a class="btn btn-sm btn-outline-primary" href="/admin/customers/edit/@customer.Id">Edit</a>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="@Permissions.Customer.Delete" Context="deleteContext">
                            <Authorized>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteAsync(customer.Id, customer.Name)">Delete</button>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<CustomerListItemDto>? customers;
    private string? statusMessage;
    private bool statusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        customers = await CustomerService.GetCustomersAsync();
    }

    private async Task ConfirmDeleteAsync(Guid customerId, string customerName)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{customerName}'?");
        if (!confirmed)
        {
            return;
        }

        var result = await CustomerService.DeleteCustomerAsync(customerId);
        statusIsError = !result.Succeeded;
        statusMessage = result.Succeeded ? "Customer deleted successfully." : string.Join(" ", result.Errors);
        await LoadCustomersAsync();
    }
}
