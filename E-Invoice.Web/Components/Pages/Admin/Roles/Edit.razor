@page "/admin/roles/edit/{RoleId:guid}"
@attribute [Authorize(Policy = Permissions.Role.Edit)]
@using System.ComponentModel.DataAnnotations
@using EInvoice.Application.Roles
@inject IRoleManagementService RoleService
@inject NavigationManager Nav
@rendermode InteractiveServer


<h1>Edit Role</h1>

@if (model is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="EditRole">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (serverErrors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in serverErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="model.Name" disabled="@isSystemRole" />
            @if (isSystemRole)
            {
                <div class="form-text">Built-in role names cannot be changed.</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="model.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Permissions</label>
            @foreach (var group in permissionGroups)
            {
                <div class="card mb-2">
                    <div class="card-header fw-bold">@group.Key</div>
                    <div class="card-body">
                        @foreach (var permission in group)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="perm-@permission.Value"
                                       checked="@model.Permissions.Contains(permission.Value)"
                                       @onchange="e => TogglePermission(permission.Value, e.Value)" />
                                <label class="form-check-label" for="perm-@permission.Value">@permission.Name</label>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/admin/roles">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid RoleId { get; set; }

    private SaveRoleFormModel? model;
    private bool isSystemRole;
    private List<string> serverErrors = new();
    private ILookup<string, PermissionInfo> permissionGroups =
        Permissions.GetAll().ToLookup(p => p.Module);

    protected override async Task OnInitializedAsync()
    {
        var role = await RoleService.GetRoleByIdAsync(RoleId);
        if (role is null)
        {
            Nav.NavigateTo("/admin/roles");
            return;
        }

        isSystemRole = role.IsSystemRole;
        model = new SaveRoleFormModel
        {
            Name = role.Name,
            Description = role.Description,
            Permissions = role.Permissions.ToList(),
        };
    }

    private void TogglePermission(string value, object? isChecked)
    {
        if (model is null)
        {
            return;
        }

        var isSelected = isChecked is bool b && b;
        if (isSelected && !model.Permissions.Contains(value))
        {
            model.Permissions.Add(value);
        }
        else if (!isSelected)
        {
            model.Permissions.Remove(value);
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        serverErrors.Clear();

        var result = await RoleService.UpdateRoleAsync(new SaveRoleDto
        {
            Id = RoleId,
            Name = model.Name,
            Description = model.Description,
            Permissions = model.Permissions,
        });

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/roles");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }

    private class SaveRoleFormModel
    {
        [Required, StringLength(256)]
        public string Name { get; set; } = string.Empty;

        [StringLength(250)]
        public string? Description { get; set; }

        public List<string> Permissions { get; set; } = new();
    }
}
