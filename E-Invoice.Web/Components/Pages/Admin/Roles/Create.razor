@page "/admin/roles/create"
@attribute [Authorize(Policy = Permissions.Role.Create)]
@using System.ComponentModel.DataAnnotations
@using EInvoice.Application.Roles
@inject IRoleManagementService RoleService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Create Role</PageTitle>

<h1>Create Role</h1>

<EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="CreateRole">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (serverErrors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in serverErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Name <span class="text-danger">*</span></label>
        <InputText class="form-control" @bind-Value="model.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="model.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Permissions</label>
        @foreach (var group in permissionGroups)
        {
            <div class="card mb-2">
                <div class="card-header fw-bold">@group.Key</div>
                <div class="card-body">
                    @foreach (var permission in group)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="perm-@permission.Value"
                                   checked="@model.Permissions.Contains(permission.Value)"
                                   @onchange="e => TogglePermission(permission.Value, e.Value)" />
                            <label class="form-check-label" for="perm-@permission.Value">@permission.Name</label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" href="/admin/roles">Cancel</a>
</EditForm>

@code {
    private readonly SaveRoleFormModel model = new();
    private List<string> serverErrors = new();
    private ILookup<string, PermissionInfo> permissionGroups =
        Permissions.GetAll().ToLookup(p => p.Module);

    private void TogglePermission(string value, object? isChecked)
    {
        var isSelected = isChecked is bool b && b;
        if (isSelected && !model.Permissions.Contains(value))
        {
            model.Permissions.Add(value);
        }
        else if (!isSelected)
        {
            model.Permissions.Remove(value);
        }
    }

    private async Task HandleSubmitAsync()
    {
        serverErrors.Clear();

        var result = await RoleService.CreateRoleAsync(new SaveRoleDto
        {
            Name = model.Name,
            Description = model.Description,
            Permissions = model.Permissions,
        });

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/roles");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }

    private class SaveRoleFormModel
    {
        [Required, StringLength(256)]
        public string Name { get; set; } = string.Empty;

        [StringLength(250)]
        public string? Description { get; set; }

        public List<string> Permissions { get; set; } = new();
    }
}
