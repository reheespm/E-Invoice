@page "/admin/countries/edit/{CountryId:guid}"
@attribute [Authorize(Policy = Permissions.Country.Edit)]
@using System.ComponentModel.DataAnnotations
@using EInvoice.Application.Countries
@inject ICountryManagementService CountryService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Edit Country</PageTitle>

<h1>Edit Country</h1>

@if (model is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="EditCountry">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (serverErrors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in serverErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="model.Name" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/admin/countries">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid CountryId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private SaveCountryFormModel? model;
    private List<string> serverErrors = new();

    protected override async Task OnInitializedAsync()
    {
        var country = await CountryService.GetCountryByIdAsync(CountryId);
        if (country is null)
        {
            Nav.NavigateTo("/admin/countries");
            return;
        }

        model = new SaveCountryFormModel
        {
            Name = country.Name,
        };
    }

    private async Task HandleSubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        serverErrors.Clear();

        string? performedBy = null;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            performedBy = authState.User.Identity?.Name;
        }

        var result = await CountryService.UpdateCountryAsync(new SaveCountryDto
        {
            Id = CountryId,
            Name = model.Name,
            PerformedBy = performedBy,
        });

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/countries");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }

    private class SaveCountryFormModel
    {
        [Required, StringLength(100)]
        public string Name { get; set; } = string.Empty;
    }
}
