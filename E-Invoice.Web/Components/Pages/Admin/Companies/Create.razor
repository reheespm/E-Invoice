@page "/admin/companies/create"
@attribute [Authorize(Policy = Permissions.Company.Create)]
@using EInvoice.Application.Cities
@using EInvoice.Application.Companies
@using EInvoice.Application.Countries
@inject ICompanyManagementService CompanyService
@inject ICountryManagementService CountryService
@inject ICityManagementService CityService
@inject NavigationManager Nav
@rendermode InteractiveServer


<h1>Add Company</h1>

<EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="CreateCompany">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (serverErrors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in serverErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <CompanyFormFields Model="model" Countries="availableCountries" Cities="allCities" />

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" href="/admin/companies">Cancel</a>
</EditForm>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly CompanyFormModel model = new();
    private List<string> serverErrors = new();
    private IReadOnlyList<CountryListItemDto> availableCountries = Array.Empty<CountryListItemDto>();
    private IReadOnlyList<CityListItemDto> allCities = Array.Empty<CityListItemDto>();

    protected override async Task OnInitializedAsync()
    {
        availableCountries = await CountryService.GetCountriesAsync();
        allCities = await CityService.GetCitiesAsync();
    }

    private async Task HandleSubmitAsync()
    {
        serverErrors.Clear();

        string? performedBy = null;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            performedBy = authState.User.Identity?.Name;
        }

        var result = await CompanyService.CreateCompanyAsync(model.ToDto(null, performedBy));

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/companies");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }
}
