@page "/admin/companies/edit/{CompanyId:guid}"
@attribute [Authorize(Policy = Permissions.Company.Edit)]
@using EInvoice.Application.Cities
@using EInvoice.Application.Companies
@using EInvoice.Application.Countries
@inject ICompanyManagementService CompanyService
@inject ICountryManagementService CountryService
@inject ICityManagementService CityService
@inject NavigationManager Nav
@rendermode InteractiveServer


<h1>Edit Company</h1>

@if (model is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="EditCompany">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (serverErrors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in serverErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <CompanyFormFields Model="model" Countries="availableCountries" Cities="allCities" />

        <div class="text-muted small mb-3">
            Created @createdAtUtc.ToString("g") @(string.IsNullOrWhiteSpace(createdBy) ? "" : $"by {createdBy}")
            @if (modifiedAtUtc is not null)
            {
                <br />
                @:Last modified @modifiedAtUtc.Value.ToString("g") @(string.IsNullOrWhiteSpace(modifiedBy) ? "" : $"by {modifiedBy}")
            }
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/admin/companies">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid CompanyId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private CompanyFormModel? model;
    private List<string> serverErrors = new();
    private DateTime createdAtUtc;
    private string? createdBy;
    private DateTime? modifiedAtUtc;
    private string? modifiedBy;
    private IReadOnlyList<CountryListItemDto> availableCountries = Array.Empty<CountryListItemDto>();
    private IReadOnlyList<CityListItemDto> allCities = Array.Empty<CityListItemDto>();

    protected override async Task OnInitializedAsync()
    {
        availableCountries = await CountryService.GetCountriesAsync();
        allCities = await CityService.GetCitiesAsync();

        var company = await CompanyService.GetCompanyByIdAsync(CompanyId);
        if (company is null)
        {
            Nav.NavigateTo("/admin/companies");
            return;
        }

        createdAtUtc = company.CreatedAtUtc;
        createdBy = company.CreatedBy;
        modifiedAtUtc = company.ModifiedAtUtc;
        modifiedBy = company.ModifiedBy;

        model = CompanyFormModel.FromDetail(company);
    }

    private async Task HandleSubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        serverErrors.Clear();

        string? performedBy = null;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            performedBy = authState.User.Identity?.Name;
        }

        var result = await CompanyService.UpdateCompanyAsync(model.ToDto(CompanyId, performedBy));

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/companies");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }
}
