@page "/admin/cities/edit/{CityId:guid}"
@attribute [Authorize(Policy = Permissions.City.Edit)]
@using System.ComponentModel.DataAnnotations
@using EInvoice.Application.Cities
@using EInvoice.Application.Countries
@inject ICityManagementService CityService
@inject ICountryManagementService CountryService
@inject NavigationManager Nav
@rendermode InteractiveServer


<h1>Edit City</h1>

@if (model is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="EditCity">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        @if (serverErrors.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in serverErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Country <span class="text-danger">*</span></label>
            <InputSelect class="form-select" @bind-Value="model.CountryId">
                <option value="">-- Select country --</option>
                @if (availableCountries is not null)
                {
                    @foreach (var country in availableCountries)
                    {
                        <option value="@country.Id">@country.Name</option>
                    }
                }
            </InputSelect>
        </div>

        <div class="mb-3" style="max-width: 400px;">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="model.Name" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/admin/cities">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid CityId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private SaveCityFormModel? model;
    private IReadOnlyList<CountryListItemDto>? availableCountries;
    private List<string> serverErrors = new();

    protected override async Task OnInitializedAsync()
    {
        availableCountries = await CountryService.GetCountriesAsync();

        var city = await CityService.GetCityByIdAsync(CityId);
        if (city is null)
        {
            Nav.NavigateTo("/admin/cities");
            return;
        }

        model = new SaveCityFormModel
        {
            Name = city.Name,
            CountryId = city.CountryId,
        };
    }

    private async Task HandleSubmitAsync()
    {
        if (model is null)
        {
            return;
        }

        serverErrors.Clear();

        string? performedBy = null;
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            performedBy = authState.User.Identity?.Name;
        }

        var result = await CityService.UpdateCityAsync(new SaveCityDto
        {
            Id = CityId,
            Name = model.Name,
            CountryId = model.CountryId!.Value,
            PerformedBy = performedBy,
        });

        if (result.Succeeded)
        {
            Nav.NavigateTo("/admin/cities");
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }

    private class SaveCityFormModel
    {
        [Required, StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Country is required.")]
        public Guid? CountryId { get; set; }
    }
}
