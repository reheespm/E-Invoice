<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EInvoice.Web</RootNamespace>
    <UserSecretsId>21b22e8e-b007-4f6a-93b1-21238e44d796</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by "dotnet ef migrations add" (E-Invoice.Web is the startup project) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\E-Invoice.Domain\E-Invoice.Domain.csproj" />
    <ProjectReference Include="..\E-Invoice.Application\E-Invoice.Application.csproj" />
    <ProjectReference Include="..\E-Invoice.Infrastructure\E-Invoice.Infrastructure.csproj" />
  </ItemGroup>

</Project>
